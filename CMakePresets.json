{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt",
      "displayName": "Windows: Qt installer's MinGW + Ninja (no PATH or Qt path needed)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {
        "PATH": "C:/Qt/Tools/mingw1310_64/bin;C:/Qt/Tools/Ninja;C:/Qt/Tools/CMake_64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "C:/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "mingw",
      "displayName": "Windows MinGW (Ninja) - use in MSYS2 MinGW64 shell or with MinGW on PATH",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "mingw-make",
      "displayName": "Windows MinGW (MinGW Makefiles) - if you do not have Ninja",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "unix",
      "displayName": "Linux / macOS (Unix Makefiles)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt",
      "configurePreset": "qt"
    },
    {
      "name": "mingw",
      "configurePreset": "mingw"
    },
    {
      "name": "mingw-make",
      "configurePreset": "mingw-make"
    },
    {
      "name": "unix",
      "configurePreset": "unix"
    }
  ]
}